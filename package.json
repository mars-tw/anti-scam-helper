{
  "name": "line-js-local-client",
  "version": "1.6.5",
  "private": true,
  "description": "Local-only LINE web client",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web --outDir ../dist/web --emptyOutDir",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "start": "node dist/main.js",
    "update": "node scripts/update.mjs",
    "cli": "node scripts/cli.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "guard": "node guard/guard.mjs",
    "guard:forever": "node guard/supervise.mjs",
    "guard:all": "node guard/supervise.mjs --with-server"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@3.4.2",
    "@evex/linejs-types": "npm:@jsr/evex__linejs-types@3.4.2",
    "qrcode": "1.5.4",
    "undici": "7.30.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "overrides": {
    "thrift": "0.23.0"
  }
}
